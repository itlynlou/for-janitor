# Port the proxy listens on (most hosts set this automatically)
PORT=3000

# Optional: bake in a Zen key so you don't have to paste one into Janitor AI.
# Leave blank to require each caller to send their own key as a Bearer token
# (recommended if you'll ever share this proxy URL with anyone else).
ZEN_API_KEY=

# Set to "false" to allow paid Zen models through too. Default: free-only.
FREE_ONLY=true
